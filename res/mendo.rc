#include <winresrc.h>
#include "../src/ui/resource.h"

// Icon
IDI_APP_ICON ICON "mendo.ico"

// Manifest
1 RT_MANIFEST "mendo.manifest"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,1,2,3
PRODUCTVERSION 0,1,2,3
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "FileDescription", "mendo - Insanely Fast Markdown Viewer"
            VALUE "FileVersion", "0.1.2.3"
            VALUE "InternalName", "mendo"
            VALUE "OriginalFilename", "mendo.exe"
            VALUE "ProductName", "mendo"
            VALUE "ProductVersion", "0.1.2.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END

// Embedded mermaid.js (gzip compressed) for offline rendering
IDR_MERMAID_JS_GZ RCDATA "..\\third_party\\mermaid\\mermaid.min.js.gz"

// Embedded help documents (UTF-8 Markdown)
IDR_HELP_MD    RCDATA "help_ja.md"
IDR_HELP_EN_MD RCDATA "help_en.md"
