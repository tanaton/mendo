#include <winresrc.h>
#include "../src/util/resource.h"

// Icon
IDI_APP_ICON ICON "mendo.ico"

// Manifest
1 RT_MANIFEST "mendo.manifest"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,4,1,0
PRODUCTVERSION 0,4,1,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "mendo - Insanely Fast Markdown Viewer"
            VALUE "FileVersion", "0.4.1.0"
            VALUE "InternalName", "mendo"
            VALUE "LegalCopyright", "Copyright (c) 2025 tanaton"
            VALUE "OriginalFilename", "mendo.exe"
            VALUE "ProductName", "mendo"
            VALUE "ProductVersion", "0.4.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

// Embedded libraries for offline rendering (pele: mermaid diagrams, KaTeX: math)
IDR_PELE_JS  RCDATA "../third_party/pele/pele.mjs"
IDR_KATEX_JS RCDATA "../third_party/katex/katex.min.js"
// IDR_KATEX_FONT_FIRST + i, in the order of kKatexFontFiles (diagram_raster.h)
320 RCDATA "../third_party/katex/fonts/KaTeX_AMS-Regular.woff2"
321 RCDATA "../third_party/katex/fonts/KaTeX_Caligraphic-Bold.woff2"
322 RCDATA "../third_party/katex/fonts/KaTeX_Caligraphic-Regular.woff2"
323 RCDATA "../third_party/katex/fonts/KaTeX_Fraktur-Bold.woff2"
324 RCDATA "../third_party/katex/fonts/KaTeX_Fraktur-Regular.woff2"
325 RCDATA "../third_party/katex/fonts/KaTeX_Main-Bold.woff2"
326 RCDATA "../third_party/katex/fonts/KaTeX_Main-BoldItalic.woff2"
327 RCDATA "../third_party/katex/fonts/KaTeX_Main-Italic.woff2"
328 RCDATA "../third_party/katex/fonts/KaTeX_Main-Regular.woff2"
329 RCDATA "../third_party/katex/fonts/KaTeX_Math-BoldItalic.woff2"
330 RCDATA "../third_party/katex/fonts/KaTeX_Math-Italic.woff2"
331 RCDATA "../third_party/katex/fonts/KaTeX_SansSerif-Bold.woff2"
332 RCDATA "../third_party/katex/fonts/KaTeX_SansSerif-Italic.woff2"
333 RCDATA "../third_party/katex/fonts/KaTeX_SansSerif-Regular.woff2"
334 RCDATA "../third_party/katex/fonts/KaTeX_Script-Regular.woff2"
335 RCDATA "../third_party/katex/fonts/KaTeX_Size1-Regular.woff2"
336 RCDATA "../third_party/katex/fonts/KaTeX_Size2-Regular.woff2"
337 RCDATA "../third_party/katex/fonts/KaTeX_Size3-Regular.woff2"
338 RCDATA "../third_party/katex/fonts/KaTeX_Size4-Regular.woff2"
339 RCDATA "../third_party/katex/fonts/KaTeX_Typewriter-Regular.woff2"

// Embedded help documents (UTF-8 Markdown)
IDR_HELP_MD    RCDATA "help_ja.md"
IDR_HELP_EN_MD RCDATA "help_en.md"
IDR_HELP_ZH_MD RCDATA "help_zh.md"
IDR_HELP_ZH_HANT_MD RCDATA "help_zh_hant.md"
IDR_HELP_KO_MD RCDATA "help_ko.md"

IDR_THIRD_PARTY_LICENSES_MD RCDATA "../THIRD_PARTY_LICENSES.md"
